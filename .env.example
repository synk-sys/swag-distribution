# ---------------------------------------------------------------------------
# DevFest Toronto 2026 swag distribution
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# "demo" (default): in-memory fictional data, no Firebase needed.
# "production": Firebase Auth + Firestore.
NEXT_PUBLIC_APP_MODE=demo

# Optional: fixed secret for demo session cookies (random per process if unset).
DEMO_SESSION_SECRET=

# --- Firebase web app config (Project settings → Your apps → Web app). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server (Admin SDK). On App Hosting, Application Default Credentials are used
# automatically. Locally: `gcloud auth application-default login`, or set:
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # single line; prefer ADC

# --- Emulators (local testing only)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
