# ---------------------------------------------------------------------------
# DevFest Toronto 2026 swag distribution
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# "demo" (default): in-memory fictional data, no Supabase needed.
# "production": Supabase Auth + Postgres + Realtime.
NEXT_PUBLIC_APP_MODE=demo

# Optional: fixed secret for demo session cookies (random per process if unset).
DEMO_SESSION_SECRET=

# --- Supabase (Project Settings → API). URL and anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app (used in invite / password emails), e.g. https://swag.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only. NEVER prefix these with NEXT_PUBLIC_.
# Service role key: verifies access tokens and invites staff (Project Settings → API).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Connect → Transaction pooler, port 6543):
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
# Optional: max pooled connections per server instance (default 10).
# PG_POOL_MAX=10

# --- Tests only: a THROWAWAY database (it is wiped), e.g. from `supabase start`.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
