rules_version = '2';

// The attendee database is NEVER readable or writable from browsers.
// All reads and writes go through authenticated, role-checked server routes
// using the Admin SDK (which bypasses these rules). Browsers may only listen
// to a change counter so the UI can refresh in real time.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.role in ['organizer', 'volunteer'];
    }

    match /meta/live {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
